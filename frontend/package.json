{
  "name": "app",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22",
    "npm": ">=10"
  },
  "scripts": {
    "ng": "ng",
    "start": "cross-env ASSETS_DIR=src/assets/files ng serve --open --ssl false --proxy-config proxy.local.conf.json",
    "start:docker": "cross-env ASSETS_DIR=src/assets/files ng serve --ssl false --proxy-config proxy.docker.conf.json",
    "clean:preview-cache": "node --eval \"const{rmSync,readdirSync}=require('fs');const{join}=require('path');try{readdirSync('src/assets/files/image-cache').filter(f=>/^preview_.*\\.webp$/.test(f)).forEach(f=>rmSync(join('src/assets/files/image-cache',f)))}catch{}\"",
    "prestart": "npm run clean:preview-cache && npm run generate:statics && npm run generate:icons",
    "prestart:docker": "npm run clean:preview-cache && npm run generate:statics && npm run generate:icons",
    "generate:statics": "tsx src/app/core/engine/scripts/generate-statics.ts",
    "generate:icons": "tsx src/app/core/engine/scripts/generate-icons.ts",
    "prebuild": "npm run clean:preview-cache && npm run generate:statics && npm run generate:icons",
    "build": "ng build",
    "serve:ssr": "node dist/app/server/server.mjs",
    "dev": "ng serve --open --ssl false --proxy-config proxy.local.conf.json",
    "dev:ssr": "npm run build && cross-env ASSETS_DIR=src/assets/files node dist/app/server/server.mjs",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "eslint src"
  },
  "dependencies": {
    "@angular/animations": "^19.0.0",
    "@angular/cdk": "^19.0.0",
    "@angular/common": "^19.0.0",
    "@angular/compiler": "^19.0.0",
    "@angular/core": "^19.0.0",
    "@angular/forms": "^19.0.0",
    "@angular/platform-browser": "^19.0.0",
    "@angular/platform-browser-dynamic": "^19.0.0",
    "@angular/platform-server": "^19.2.20",
    "@angular/router": "^19.0.0",
    "@angular/service-worker": "^19.0.0",
    "@angular/ssr": "^19.2.23",
    "@fortawesome/fontawesome-free": "^6.5.1",
    "@types/express": "^5.0.6",
    "bootstrap": "^5.3.3",
    "express": "^5.2.1",
    "http-proxy-middleware": "^3.0.5",
    "marked": "^15.0.0",
    "mime-types": "^3.0.2",
    "qrcode": "^1.5.4",
    "rxjs": "~7.8.0",
    "sharp": "^0.33.0",
    "sweetalert2": "^11.0.0",
    "tslib": "^2.6.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-eslint/eslint-plugin": "^21.4.0",
    "@angular-eslint/eslint-plugin-template": "^21.4.0",
    "@angular-eslint/template-parser": "^21.4.0",
    "@angular/build": "^19.0.0",
    "@angular/cli": "^19.0.0",
    "@angular/compiler-cli": "^19.0.0",
    "@types/jasmine": "^6.0.0",
    "@types/mime-types": "^3.0.1",
    "@types/qrcode": "^1.5.6",
    "cross-env": "^10.1.0",
    "eslint": "^10.1.0",
    "jasmine-core": "^6.2.0",
    "karma": "^6.4.4",
    "karma-chrome-launcher": "^3.2.0",
    "karma-coverage": "^2.2.1",
    "karma-jasmine": "^5.1.0",
    "karma-jasmine-html-reporter": "^2.2.0",
    "lighthouse": "^13.3.0",
    "pa11y": "^9.1.1",
    "tsx": "^4.19.0",
    "typescript": "~5.6.0",
    "typescript-eslint": "^8.59.4"
  }
}
