#!/bin/sh
# Pre-commit hook — esegue ESLint sul frontend prima di ogni commit.
# Installato automaticamente da `npm install` nella cartella frontend
# tramite lo script "prepare" in package.json.
#
# Per bypassare in casi eccezionali: git commit --no-verify

# Controlla se ci sono file frontend staged
STAGED=$(git diff --cached --name-only --diff-filter=ACMR | grep "^frontend/src/" || true)
if [ -z "$STAGED" ]; then
    exit 0
fi

ROOT="$(git rev-parse --show-toplevel)"
echo "→ ESLint accessibility check..."
bash "${ROOT}/scripts/test/lint-check.sh"
STATUS=$?

if [ $STATUS -ne 0 ]; then
    echo ""
    echo "✗ ESLint ha trovato errori. Correggili prima di fare commit."
    echo "  Esegui: cd frontend && npm run lint"
    echo "  Per bypassare (solo se sai cosa fai): git commit --no-verify"
    exit 1
fi
